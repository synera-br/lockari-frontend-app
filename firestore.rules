
rules_version = '2';

// Lock down Firestore rules to deny all client-side access.
// All data access MUST go through the backend Go services, which use the Admin SDK
// and bypass these rules. This is the correct security model for this architecture.
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all reads and writes to all collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
